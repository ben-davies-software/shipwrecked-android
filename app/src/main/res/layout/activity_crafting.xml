<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#060F1A"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#0D1F2D"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnBackFromCrafting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back"
            android:textSize="12sp"
            android:backgroundTint="#055F6E"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Crafting"
            android:textColor="#17B8C8"
            android:textSize="20sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- Inventory reminder -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#081520"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You have:  "
            android:textColor="#17B8C8"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvCraftWood"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wood:0  "
            android:textColor="#B8DCE8"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/tvCraftVine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vine:0  "
            android:textColor="#B8DCE8"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/tvCraftFlint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Flint:0"
            android:textColor="#B8DCE8"
            android:textSize="12sp"/>

    </LinearLayout>

    <!-- Recipe list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRecipes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="12dp"
        android:clipToPadding="false"/>

</LinearLayout>