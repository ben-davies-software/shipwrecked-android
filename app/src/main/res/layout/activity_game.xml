<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#060F1A"
    android:fitsSystemWindows="true">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#0D1F2D"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvDayCounter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Day 1"
            android:textColor="#17B8C8"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/cinzel_bold"/>

        <TextView
            android:id="@+id/tvActionsRemaining"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Actions: 3"
            android:textColor="#B8DCE8"
            android:textSize="14sp"
            android:gravity="center"/>

        <Button
            android:id="@+id/btnCrafting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crafting"
            android:textSize="12sp"
            android:backgroundTint="#0A7B8C"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

    <!-- Stats Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0A1A26"
        android:padding="12dp">

        <!-- Health -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="Health"
                android:textColor="#B8DCE8"
                android:textSize="12sp"/>

            <ProgressBar
                android:id="@+id/pbHealth"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="100"
                android:progressTint="#E74C3C"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tvHealthVal"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:text="100"
                android:textColor="#B8DCE8"
                android:textSize="12sp"
                android:gravity="end"/>

        </LinearLayout>

        <!-- Hunger -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="Hunger"
                android:textColor="#B8DCE8"
                android:textSize="12sp"/>

            <ProgressBar
                android:id="@+id/pbHunger"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="100"
                android:progressTint="#F39C12"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tvHungerVal"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:text="100"
                android:textColor="#B8DCE8"
                android:textSize="12sp"
                android:gravity="end"/>

        </LinearLayout>

        <!-- Energy -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="Energy"
                android:textColor="#B8DCE8"
                android:textSize="12sp"/>

            <ProgressBar
                android:id="@+id/pbEnergy"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="100"
                android:progressTint="#1ABC9C"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tvEnergyVal"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:text="100"
                android:textColor="#B8DCE8"
                android:textSize="12sp"
                android:gravity="end"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Inventory Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#081520"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inventory: "
            android:textColor="#17B8C8"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvWood"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wood:0 "
            android:textColor="#B8DCE8"
            android:textSize="12sp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tvVine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vine:0 "
            android:textColor="#B8DCE8"
            android:textSize="12sp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tvFood"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Food:0 "
            android:textColor="#B8DCE8"
            android:textSize="12sp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tvFlint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Flint:0"
            android:textColor="#B8DCE8"
            android:textSize="12sp"/>

    </LinearLayout>

    <!-- Raft Progress Bar -->
    <LinearLayout
        android:id="@+id/layoutRaftProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#060F1A"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Raft: "
            android:textColor="#17B8C8"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <ProgressBar
            android:id="@+id/pbRaft"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_weight="1"
            android:max="3"
            android:progress="0"
            android:progressTint="#17B8C8"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tvRaftProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/3"
            android:textColor="#17B8C8"
            android:textSize="12sp"/>

    </LinearLayout>

    <!-- Narrative Log -->
    <ScrollView
        android:id="@+id/scrollNarrative"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:background="#060F1A">

        <TextView
            android:id="@+id/tvNarrative"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#B8DCE8"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.4"/>

    </ScrollView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0D1F2D"
        android:padding="8dp">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btnForage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Forage"
                android:textSize="11sp"
                android:backgroundTint="#0D4A3A"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnHunt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hunt"
                android:textSize="11sp"
                android:backgroundTint="#2A1F3D"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnFish"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Fish"
                android:textSize="11sp"
                android:backgroundTint="#0A4A5A"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btnWood"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Get Wood"
                android:textSize="11sp"
                android:backgroundTint="#1A3A4A"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnVine"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Get Vine"
                android:textSize="11sp"
                android:backgroundTint="#0D3D2A"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnExplore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Explore"
                android:textSize="11sp"
                android:backgroundTint="#1A2A4A"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Rest"
                android:textSize="11sp"
                android:backgroundTint="#1A2A30"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnBuild"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Build Raft"
                android:textSize="11sp"
                android:backgroundTint="#055F6E"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnEndDay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="End Day"
                android:textSize="11sp"
                android:backgroundTint="#0A7B8C"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>